+0.010      key tap pause
+0.010      key tap printscreen
+0.010      key tap prtsc
+0.050      key tap ctrl+alt+delete
+0.050      key press shift+ctrl
+0.050      key release shift+ctrl
+0.050      type "The quick brown fox: 0123456789!"
+0.050      type "~!@#$%^&*()_+{}|:\"<>?`-=[]\\;',./"
+0.050      type "a\tb\nc"
