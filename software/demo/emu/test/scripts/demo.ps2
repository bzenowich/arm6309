# demo.ps2 - the worked example from software/demo/emu/ps2script.h.
#
# Screen coordinates, Y DOWN; the encoder negates Y into ps2.md 11.3's
# "positive upward" and splits anything past the 9-bit field.  Nothing here
# needs a GUI: it is what the format looks like when there is one.

origin 0 0                  # where the pointer already is; emits nothing

at 0.500    move to 320 240 # 320 right and 240 down: 2 packets (255 + 65)
+0.100      click left      # press, `gap`, release - at 320,240
+0.200      move by 700 -5  # off the 9-bit field: 3 packets, -5 is UP
+0.200      down right      # a drag: the button rides every packet after it
+0.050      move to 1020 400
+0.050      up right

+0.300      key tap enter
+0.100      key tap ctrl+c  # a chord: make in order, break in reverse
+0.100      type "Hi there!"
