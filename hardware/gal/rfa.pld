Name       rfa ;
PartNo     ARM6309-UV9 ;
Date       2026-09-09 ;
Revision   02 ;
Designer   arm6309 ;
Company    - ;
Assembly   - ;
Location   video card - register-file address ;
Device     g22v10 ;

/* ------------------------------------------------------------------------
 * rfa - the register-file address, and 7.4's colour path.
 *
 * graphics.md 10.1.6.3's relief, taken on 2026-09-08: RA4..RA0 and WSTB came
 * off vctrl, which was at 64 of 64 I/O, and this part recomputes REGSEL from
 * IOSEL & A6 & A5 rather than importing it.
 *
 * ** REVISION 02, 2026-09-09, and it is 7.4's mechanism rather than a walk
 * towards it.
 *
 * XX WHAT REVISION 01 HAD: a two-bit walk on FP1:FP0 that presented SPANLEN,
 * WFG and WBG in turn while the span writer was IDLE - "two deferrable file
 * reads that fetch all three for the next span". Nothing on the card produced
 * FP0 or FP1; nothing received the three values; and every term of the walk
 * carried !SPANBUSY, so DURING a span the file address was $00 and the span
 * writer would have retired CTRL's byte into the framebuffer.
 * docs/design-review2.md V-1.
 *
 * ** WHAT REPLACES IT is the sentence 7.4 already wrote: "the serialiser's
 * serial output is wired to the register file's address bit 0, which is why 13
 * requires WFG at A0 = 0 and WBG at A0 = 1. Choosing the source colour per
 * pixel costs no macrocell and no product term - it is an address line." The
 * file is addressed LIVE and the mask bit is that line:
 *
 *   REGSEL          the CPU's own access          RA = A4..A0
 *   span in flight  $06 or $07, per the mask bit  RA = 0011 !MASKBIT
 *   idle            $05, SPANLEN                  RA = 00101
 *   reload, dot 1   $08, WPTR's low byte          RA = 01000
 *   reload, dot 2   $09, its middle byte          RA = 01001
 *
 * !! IT IS THE COMPLEMENT OF THE MASK BIT. WFG is $06 and WBG $07, so A0 = 0
 * is the FOREGROUND - and 7.4's table says a `0` mask bit writes WBG, because
 * a glyph's set bits are its ink. On a '165 that is /QH rather than QH; here
 * it is one literal.
 *
 * ** THE IDLE CASE IS LOAD-BEARING. With the file holding SPANLEN whenever no
 * span is running, vlen's counter loads at the posted write with no walk, no
 * phase and no state of its own - which is what deleted FP0, FP1 and the two
 * macrocells they would have cost on vctrl.
 *
 * ** THE RELOAD IS 7.2's COLUMN RESTORE. vaddr walks RP1:RP0 through 01 and 10
 * at span end and this part points the file at WPTR's own bytes for those two
 * dots, so wcol reloads through the load path the CPU's write already uses -
 * "two deferrable file reads to restore the column ... no latch, no mux". The
 * row half of WADV was built and this half was not, so a chained glyph stepped
 * eight pixels right on every row. docs/design-review2.md V-6.
 *
 * ** TWO STROBES MOVED HERE TOO. CTRL's write strobe and VSTAT's were inputs
 * to vctrl that nothing produced, so CTRL could not be written at all and the
 * VBL flag could not be cleared. They belong on the part that has RA4..RA0.
 *
 * PIN PLACEMENT MATCHES regfile.jedec.ts's place(), which pairs the widest
 * equation with the widest macrocell still free: RA0 is ten terms and lands on
 * pin 19's sixteen.
 * ------------------------------------------------------------------------ */

/* --- inputs ----------------------------------------------------------- */
PIN 1 = IOSEL ;      /* the motherboard's $FF00-$FF7F window strobe        */
PIN 2 = A5 ;         /* REGSEL is IOSEL & A6 & A5 - this card's upper half */
PIN 3 = A6 ;
PIN 4 = A0 ;
PIN 5 = A1 ;
PIN 6 = A2 ;
PIN 7 = A3 ;
PIN 8 = A4 ;
PIN 9 = RW ;
PIN 10 = E ;
PIN 11 = SPANBUSY ;  /* from vctrl - VSTAT b7, and the span writer's state  */
PIN 13 = MASKBIT ;   /* from vctrl - the serialiser's current bit           */
PIN 22 = RP0 ;       /* from vaddr - 7.2's column reload walk               */
PIN 23 = RP1 ;       /*   two macrocell pins used as inputs, which is what  */
                     /*   pins 22 and 23 were being kept for                */

/* --- outputs ---------------------------------------------------------- */
PIN 14 = WSTB ;      /* the register file's write strobe, and vaddr's decode */
PIN 15 = RA4 ;
PIN 16 = WCTRL ;     /* 13's +$00 - to vctrl, which holds CTRL              */
PIN 17 = RA1 ;
PIN 18 = RA3 ;
PIN 19 = RA0 ;       /* ten terms, on the widest macrocell                  */
PIN 20 = RA2 ;
PIN 21 = VSTATWR ;   /* 13's +$13 - to vctrl, which holds the VBL flag      */

/* --- intermediate terms ----------------------------------------------- */
regsel = IOSEL & A6 & A5 ;

/* --- equations -------------------------------------------------------- */
WSTB = regsel & !RW & E ;

/* $05 is 00101, $06/$07 are 0011x and $08/$09 are 0100x. Bit 2 is set in the
 * first three and clear in the reload; bit 3 is the reload's alone; bit 1
 * separates the colour pair from the length; bit 0 is the length's own bit
 * when idle, the mask bit during a span, and the reload's second dot. */
RA0 = regsel & A0
    # !regsel & SPANBUSY & !MASKBIT
    # !regsel & !SPANBUSY & !RP0 & !RP1
    # !regsel & RP1 ;
RA1 = regsel & A1
    # !regsel & SPANBUSY ;
RA2 = regsel & A2
    # !regsel & !RP0 & !RP1 ;
RA3 = regsel & A3
    # !regsel & RP0
    # !regsel & RP1 ;
RA4 = regsel & A4 ;

/* The two strobes vctrl gave up the address lines to decode. */
WCTRL   = regsel & !RW & E & !A4 & !A3 & !A2 & !A1 & !A0 ;
VSTATWR = regsel & !RW & E &  A4 & !A3 & !A2 &  A1 &  A0 ;
