        # !HLOAD & !MCADV & MC4 ;
MC5.d = HLOAD & HS8
        # !HLOAD & MCADV & MC5 & !MC0
        # !HLOAD & MCADV & MC5 & !MC1
        # !HLOAD & MCADV & MC5 & !MC2
        # !HLOAD & MCADV & MC5 & !MC3
        # !HLOAD & MCADV & MC5 & !MC4
        # !HLOAD & MCADV & !MC5 & MC0 & MC1 & MC2 & MC3 & MC4
        # !HLOAD & !MCADV & MC5 ;
MC6.d = HLOAD & HS9
        # !HLOAD & MCADV & MC6 & !MC0
        # !HLOAD & MCADV & MC6 & !MC1
        # !HLOAD & MCADV & MC6 & !MC2
        # !HLOAD & MCADV & MC6 & !MC3
        # !HLOAD & MCADV & MC6 & !MC4
        # !HLOAD & MCADV & MC6 & !MC5
        # !HLOAD & MCADV & !MC6 & MC0 & MC1 & MC2 & MC3 & MC4 & MC5
        # !HLOAD & !MCADV & MC6 ;
MAPA0 = MC0 ;
MAPA1 = MC1 ;
RP0.d = !RP1 & !RP0 & WROWADV ;
RP1.d = !RP1 & RP0 ;
RLDA = RP0 & !RP1 ;
RLDB = RP1 & !RP0 ;
LDVSL = WSTB & !RA4 & !RA3 & !RA2 & !RA1 & RA0 ;
LDVSH = WSTB & !RA4 & !RA3 & !RA2 & RA1 & !RA0 ;
LDHS = WSTB & !RA4 & !RA3 & !RA2 & RA1 & RA0 ;
LDHSH = WSTB & !RA4 & !RA3 & RA2 & !RA1 & !RA0 ;
LDA = WSTB & !RA4 & RA3 & !RA2 & !RA1 & !RA0 ;
LDB = WSTB & !RA4 & RA3 & !RA2 & !RA1 & RA0 ;
LDC = WSTB & !RA4 & RA3 & !RA2 & RA1 & !RA0 ;
LDTB = WSTB & RA4 & !RA3 & RA2 & RA1 & RA0 ;
LDMB = WSTB & RA4 & RA3 & !RA2 & !RA1 & RA0 ;
WINC = RETIRE
       # VINC ;
FBA2 = !SRC1 & !SRC0 & SA2
       # !SRC1 & SRC0 & WA2
       # SRC1 & !SRC0 & SA2
       # SRC1 & SRC0 & MC2 ;
FBA3 = !SRC1 & !SRC0 & SA3
       # !SRC1 & SRC0 & WA3
       # SRC1 & !SRC0 & SA10
       # SRC1 & SRC0 & MC3 ;
FBA4 = !SRC1 & !SRC0 & SA4
       # !SRC1 & SRC0 & WA4
       # SRC1 & !SRC0 & SA11
       # SRC1 & SRC0 & MC4 ;
FBA5 = !SRC1 & !SRC0 & SA5
       # !SRC1 & SRC0 & WA5
       # SRC1 & !SRC0 & SA12
       # SRC1 & SRC0 & MC5 ;
FBA6 = !SRC1 & !SRC0 & SA6
       # !SRC1 & SRC0 & WA6
       # SRC1 & !SRC0 & MAPQ0
       # SRC1 & SRC0 & MC6 ;
FBA7 = !SRC1 & !SRC0 & SA7
       # !SRC1 & SRC0 & WA7
       # SRC1 & !SRC0 & MAPQ1
       # SRC1 & SRC0 & SA13 ;
FBA8 = !SRC1 & !SRC0 & SA8
       # !SRC1 & SRC0 & WA8
       # SRC1 & !SRC0 & MAPQ2
       # SRC1 & SRC0 & SA14 ;
FBA9 = !SRC1 & !SRC0 & SA9
       # !SRC1 & SRC0 & WA9
       # SRC1 & !SRC0 & MAPQ3
       # SRC1 & SRC0 & SA15 ;
FBA10 = !SRC1 & !SRC0 & SA10
        # !SRC1 & SRC0 & WA10
        # SRC1 & !SRC0 & MAPQ4
        # SRC1 & SRC0 & SA16 ;
FBA11 = !SRC1 & !SRC0 & SA11
        # !SRC1 & SRC0 & WA11
        # SRC1 & !SRC0 & MAPQ5
        # SRC1 & SRC0 & SA17 ;
FBA12 = !SRC1 & !SRC0 & SA12
        # !SRC1 & SRC0 & WA12
        # SRC1 & !SRC0 & MAPQ6
        # SRC1 & SRC0 & MB0 ;
FBA13 = !SRC1 & !SRC0 & SA13
        # !SRC1 & SRC0 & WA13
        # SRC1 & !SRC0 & MAPQ7
        # SRC1 & SRC0 & MB1 ;
FBA14 = !SRC1 & !SRC0 & SA14
        # !SRC1 & SRC0 & WA14
        # SRC1 & !SRC0 & TB0
        # SRC1 & SRC0 & MB2 ;
FBA15 = !SRC1 & !SRC0 & SA15
        # !SRC1 & SRC0 & WA15
        # SRC1 & !SRC0 & TB1
        # SRC1 & SRC0 & MB3 ;
FBA16 = !SRC1 & !SRC0 & SA16
        # !SRC1 & SRC0 & WA16
        # SRC1 & !SRC0 & TB2
        # SRC1 & SRC0 & MB4 ;
FBA17 = !SRC1 & !SRC0 & SA17
        # !SRC1 & SRC0 & WA17
        # SRC1 & !SRC0 & TB3
        # SRC1 & SRC0 & MB5 ;
FBA18 = !SRC1 & !SRC0 & SA18
        # !SRC1 & SRC0 & WA18
        # SRC1 & !SRC0 & TB4
        # SRC1 & SRC0 & MB6 ;

/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[SA2,SA3,SA4,SA5,SA6,SA7,SA8,SA9,SA10,SA11,SA12,SA13,SA14].ck = DOTCLK ;
[SA15,SA16,SA17,SA18,WA0,WA1,WA2,WA3,WA4,WA5,WA6,WA7,WA8,WA9].ck = DOTCLK ;
[WA10,WA11,WA12,WA13,WA14,WA15,WA16,WA17,WA18,HS2,HS3,HS4].ck = DOTCLK ;
[HS5,HS6,HS7,HS8,HS9,VS0,VS1,VS2,VS3,VS4,VS5,VS6,VS7,VS8,TB0].ck = DOTCLK ;
[TB1,TB2,TB3,TB4,MB0,MB1,MB2,MB3,MB4,MB5,MB6,MAP0,MAP1,MAP2].ck = DOTCLK ;
[MAP3,MAP4,MAP5,MAP6,MAP7,MAPQ0,MAPQ1,MAPQ2,MAPQ3,MAPQ4].ck = DOTCLK ;
[MAPQ5,MAPQ6,MAPQ7,MC0,MC1,MC2,MC3,MC4,MC5,MC6,RP0,RP1].ck = DOTCLK ;

/* One asynchronous reset for every register, as on the GALs. */
[SA2,SA3,SA4,SA5,SA6,SA7,SA8,SA9,SA10,SA11,SA12,SA13,SA14].ar = RESET ;
[SA15,SA16,SA17,SA18,WA0,WA1,WA2,WA3,WA4,WA5,WA6,WA7,WA8,WA9].ar = RESET ;
[WA10,WA11,WA12,WA13,WA14,WA15,WA16,WA17,WA18,HS2,HS3,HS4].ar = RESET ;
[HS5,HS6,HS7,HS8,HS9,VS0,VS1,VS2,VS3,VS4,VS5,VS6,VS7,VS8,TB0].ar = RESET ;
[TB1,TB2,TB3,TB4,MB0,MB1,MB2,MB3,MB4,MB5,MB6,MAP0,MAP1,MAP2].ar = RESET ;
[MAP3,MAP4,MAP5,MAP6,MAP7,MAPQ0,MAPQ1,MAPQ2,MAPQ3,MAPQ4].ar = RESET ;
[MAPQ5,MAPQ6,MAPQ7,MC0,MC1,MC2,MC3,MC4,MC5,MC6,RP0,RP1].ar = RESET ;
