        # MAPSEL & MB5 ;
FBA18 = LINEAR & SA18
        # SPNGRANT & WA18
        # TILESEL & TB4
        # MAPSEL & MB6 ;

/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[SA2,SA3,SA4,SA5,SA6,SA7,SA8,SA9,SA10,SA11,SA12,SA13,SA14].ck = DOTCLK ;
[SA15,SA16,SA17,SA18,WA0,WA1,WA2,WA3,WA4,WA5,WA6,WA7,WA8,WA9].ck = DOTCLK ;
[WA10,WA11,WA12,WA13,WA14,WA15,WA16,WA17,WA18,HS2,HS3,HS4].ck = DOTCLK ;
[HS5,HS6,HS7,HS8,HS9,VS0,VS1,VS2,VS3,VS4,VS5,VS6,VS7,VS8,TB0].ck = DOTCLK ;
[TB1,TB2,TB3,TB4,MB0,MB1,MB2,MB3,MB4,MB5,MB6,MAP0,MAP1,MAP2].ck = DOTCLK ;
[MAP3,MAP4,MAP5,MAP6,MAP7,LD0,LD1,LD2,LD3,LD4,LD5,LD6,LD7].ck = DOTCLK ;
[LRUN].ck = DOTCLK ;

/* One asynchronous reset for every register, as on the GALs. */
[SA2,SA3,SA4,SA5,SA6,SA7,SA8,SA9,SA10,SA11,SA12,SA13,SA14].ar = RESET ;
[SA15,SA16,SA17,SA18,WA0,WA1,WA2,WA3,WA4,WA5,WA6,WA7,WA8,WA9].ar = RESET ;
[WA10,WA11,WA12,WA13,WA14,WA15,WA16,WA17,WA18,HS2,HS3,HS4].ar = RESET ;
[HS5,HS6,HS7,HS8,HS9,VS0,VS1,VS2,VS3,VS4,VS5,VS6,VS7,VS8,TB0].ar = RESET ;
[TB1,TB2,TB3,TB4,MB0,MB1,MB2,MB3,MB4,MB5,MB6,MAP0,MAP1,MAP2].ar = RESET ;
[MAP3,MAP4,MAP5,MAP6,MAP7,LD0,LD1,LD2,LD3,LD4,LD5,LD6,LD7].ar = RESET ;
[LRUN].ar = RESET ;
