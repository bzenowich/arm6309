/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[H0,H1,H2,H3,H4,H5,H6,H7,V0,V1,V2,V3,V4,V5,V6,V7,V8,V9,VSDLY].ck = DOTCLK ;
[VBLPEND,PH0,PH1,SPANBUSY,MC0,MC1,MC2,VMODE0,VMODE1,WM0,WM1].ck = DOTCLK ;
[CELL,IRQEN,DISPEN,HS0,HS1,WADV0,WADV1,SR7,SR6,SR5,SR4,SR3].ck = DOTCLK ;
[SR2,SR1,SR0].ck = DOTCLK ;

/* One asynchronous reset for every register, as on the GALs. */
[H0,H1,H2,H3,H4,H5,H6,H7,V0,V1,V2,V3,V4,V5,V6,V7,V8,V9,VSDLY].ar = RESET ;
[VBLPEND,PH0,PH1,SPANBUSY,MC0,MC1,MC2,VMODE0,VMODE1,WM0,WM1].ar = RESET ;
[CELL,IRQEN,DISPEN,HS0,HS1,WADV0,WADV1,SR7,SR6,SR5,SR4,SR3].ar = RESET ;
[SR2,SR1,SR0].ar = RESET ;
