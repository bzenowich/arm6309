CPH.D = ((CBUSY & CPH.Q & !MUXSEL0)
	# (CBUSY & CPH.Q & !GCPY)
	# (CBUSY & !CPH.Q & GCPY & MUXSEL0));

CRDSEL = (CBUSY & !CPH.Q);

CSTEP = (CPH.Q & GCPY & MUXSEL0);

!IRQPEND.D = ((!IRQPEND.Q & VBLQ.Q)
	# (!VBLANK & A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL & WRCYC)
	# (VBLQ.Q & A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL & WRCYC)
	# (!IRQPEND.Q & !VBLANK));

IRQN = 0;

PPEND.D = ((PPEND.Q & !PS0.Q)
	# (A0 & !A1 & !A2 & !A3 & A4 & A5 & A6 & !IOSEL & !VBLANK & WRCYC));

!PALTURN = (!PS0.Q & !LUTWE.Q & !PS2.Q);

!PBUSY = (!PPEND.Q & !PS0.Q & !LUTWE.Q & !PS2.Q & !PIDXCE.Q);

PS0.D = ((A0 & !A1 & !A2 & !A3 & A4 & A5 & A6 & !IOSEL & VBLANK & WRCYC)
	# (PS0.Q & !LUTWE.Q)
	# (HLOAD & PPEND.Q));

PS2.D = ((PS2.Q & !PIDXCE.Q)
	# LUTWE.Q);

LUTWE.D = ((LUTWE.Q & !PS2.Q)
	# PS0.Q);

PIDXCE.D = PS2.Q;

RA1 = A1;

RA0 = A0;

RA3 = A3;

RCPY = CBUSY;

RA2 = A2;

RA4 = A4;

REGWR = (A5 & A6 & !IOSEL & WRCYC);

RDREQ = !RDVALID.Q;

VDSEL = (!A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL);

VBLQ.D = VBLANK;

WSTB = (A5 & A6 & !IOSEL & WRCYC);

WAITN = 0;

VSTATOE = (A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & E & !IOSEL & RW);

RDVALID.D = ((RDVALID.Q & !RETIRE & !RSTART & !WSTB)
	# RDCK);

CROWADV = (CEOR & CSTEP);

RDBKOE = (A5 & A6 & E & !IOSEL & RW & !VDSEL);

VPORT = (VDSEL
	# (A19 & !A20 & IOSEL));

CWLOAD = CROWADV;

CDONE = (CHLAST & CROWADV);

WSTBV = (E & !RW & VPORT);

RDOE = (RW & VPORT);

CPH.C = CLK25;

IRQPEND.C = CLK25;

IRQN.OE = (IRQEN & IRQPEND.Q);

PPEND.C = CLK25;

PS0.C = CLK25;

PS2.C = CLK25;

LUTWE.C = CLK25;

PIDXCE.C = CLK25;

VBLQ.C = CLK25;

WAITN.OE = ((E & !IOPGH & VPORT & !RDVALID.Q & RW)
	# (E & !IOPGH & SPANBUSY & VPORT));

RDVALID.C = CLK25;


