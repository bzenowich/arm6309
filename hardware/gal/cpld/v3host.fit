CPH.D = ((CBUSY & CPH.Q & !MUXSEL0)
	# (CBUSY & CPH.Q & !GCPY)
	# (CBUSY & !CPH.Q & GCPY & MUXSEL0));

CRDSEL = (CBUSY & !CPH.Q);

CSTEP = (CPH.Q & GCPY & MUXSEL0);

IRQN = 0;

!PALTURN = (!PS0.Q & !LUTWE.Q & !PS2.Q);

!PBUSY = (!PPEND.Q & !PS0.Q & !LUTWE.Q & !PS2.Q & !PIDXCE.Q);

LUTWE.D = ((LUTWE.Q & !PS2.Q)
	# PS0.Q);

PIDXCE.D = PS2.Q;

PS2.D = ((PS2.Q & !PIDXCE.Q)
	# LUTWE.Q);

RA1 = A1;

RA0 = A0;

RA2 = A2;

RA3 = A3;

RA4 = A4;

RCPY = CBUSY;

!RDCK = (GRD & !RDVALID.Q);

RFA1 = ((!RP1.Q & !RP2.Q & SPANBUSY)
	# RP3.Q
	# RP4.Q
	# (A1 & A5 & A6 & !IOSEL & !RP1.Q & !RP2.Q));

RDREQ = !RDVALID.Q;

RFA4 = (RP4.Q
	# (A4 & A5 & A6 & !IOSEL & !RP1.Q & !RP2.Q & !SPANBUSY)
	# RP3.Q);

RFA2 = ((!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & A2 & A5 & A6)
	# (!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & A5 & A6 & IOSEL)
	# (!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & SPANBUSY));

RFA3 = (RP1.Q
	# RP2.Q
	# (A3 & A5 & A6 & !IOSEL & !RP3.Q & !RP4.Q & !SPANBUSY));

RP2.D = RP1.Q;

RP1.D = (!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & WROWADV);

RP3.D = (CRLD.Q & RP2.Q);

RP4.D = RP3.Q;

VBLQ.D = VBLANK;

RSTART = (!E & RPQ.Q);

VSTATOE = (A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & E & !IOSEL & RW);

WRCYC = (E & !RW);

VDSEL = (!A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL);

WAITN = 0;

IRQEN.D = ((IOSEL & IRQEN.Q)
	# (!A6 & IRQEN.Q)
	# (!A5 & IRQEN.Q)
	# (!WRCYC & IRQEN.Q)
	# (A4 & IRQEN.Q)
	# (A3 & IRQEN.Q)
	# (A2 & IRQEN.Q)
	# (A1 & IRQEN.Q)
	# (A0 & IRQEN.Q)
	# (!A0 & !A1 & !A2 & !A3 & !A4 & A5 & A6 & D6 & !IOSEL & WRCYC));

CROWADV = (CEOR & CSTEP);

!IRQPEND.D = ((!IRQPEND.Q & VBLQ.Q)
	# (!VBLANK & WRCYC & A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL)
	# (VBLQ.Q & WRCYC & A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL)
	# (!IRQPEND.Q & !VBLANK));

PPEND.D = ((PPEND.Q & !PS0.Q)
	# (A0 & !A1 & !A2 & !A3 & A4 & A5 & A6 & !IOSEL & !VBLANK & WRCYC));

PS0.D = ((A0 & !A1 & !A2 & !A3 & A4 & A5 & A6 & !IOSEL & VBLANK & WRCYC)
	# (PS0.Q & !LUTWE.Q)
