CRDSEL = (CBUSY & !CPH.Q);

CPH.D = ((CBUSY & CPH.Q & !MUXSEL0)
	# (CBUSY & CPH.Q & !GCPY)
	# (CBUSY & !CPH.Q & GCPY & MUXSEL0));

CSTEP = (CPH.Q & GCPY & MUXSEL0);

IRQN = 0;

!IRQPEND.D = ((!IRQPEND.Q & VBLQ.Q)
	# (!VBLANK & A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL & WRCYC)
	# (VBLQ.Q & A0 & !A1 & A2 & A3 & !A4 & A5 & A6 & !IOSEL & WRCYC)
	# (!IRQPEND.Q & !VBLANK));

!PALTURN = (!PS0.Q & !LUTWE.Q & !PS2.Q);

!PBUSY = (!PPEND.Q & !PS0.Q & !LUTWE.Q & !PS2.Q & !PIDXCE.Q);

PPEND.D = ((PPEND.Q & !PS0.Q)
	# (A0 & !A1 & !A2 & !A3 & A4 & A5 & A6 & !IOSEL & !VBLANK & WRCYC));

LUTWE.D = ((LUTWE.Q & !PS2.Q)
	# PS0.Q);

PS0.D = ((A0 & !A1 & !A2 & !A3 & A4 & A5 & A6 & !IOSEL & VBLANK & WRCYC)
	# (PS0.Q & !LUTWE.Q)
	# (HLOAD & PPEND.Q));

PS2.D = ((PS2.Q & !PIDXCE.Q)
	# LUTWE.Q);

PIDXCE.D = PS2.Q;

RA0 = A0;

RA1 = A1;

RA4 = A4;

RA2 = A2;

RA3 = A3;

RCPY = CBUSY;

RDREQ = !RDVALID.Q;

RFA2 = ((!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & A2 & A5 & A6)
	# (!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & A5 & A6 & IOSEL)
	# (!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & SPANBUSY));

REGWR = (A5 & A6 & !IOSEL & WRCYC);

RFA1 = ((!RP1.Q & !RP2.Q & SPANBUSY)
	# RP3.Q
	# RP4.Q
	# (A1 & A5 & A6 & !IOSEL & !RP1.Q & !RP2.Q));

RP2.D = RP1.Q;

RFA3 = (RP1.Q
	# RP2.Q
	# (A3 & A5 & A6 & !IOSEL & !RP3.Q & !RP4.Q & !SPANBUSY));

RFA4 = (RP4.Q
	# (A4 & A5 & A6 & !IOSEL & !RP1.Q & !RP2.Q & !SPANBUSY)
	# RP3.Q);

RP1.D = (!RP1.Q & !RP2.Q & !RP3.Q & !RP4.Q & WROWADV);

RP3.D = (CRLD.Q & RP2.Q);

RP4.D = RP3.Q;

VBLQ.D = VBLANK;

