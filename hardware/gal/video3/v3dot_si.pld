        # SPRSH & !SPRHIT & SW2 & !SW1
        # SPRSH & !SPRHIT & !SW2 & SW0 & SW1
        # !SPRSH & SW2 ;
SR0.d = ROWADV & !SPRVHIT & !SR0
        # !ROWADV & SR0 ;
SR1.d = ROWADV & !SPRVHIT & SR1 & !SR0
        # ROWADV & !SPRVHIT & !SR1 & SR0
        # !ROWADV & SR1 ;
SR2.d = ROWADV & !SPRVHIT & SR2 & !SR0
        # ROWADV & !SPRVHIT & SR2 & !SR1
        # ROWADV & !SPRVHIT & !SR2 & SR0 & SR1
        # !ROWADV & SR2 ;
SH00.d = SPRLD & D0
         # !SPRLD & SPRSH & SH01
         # !SPRLD & !SPRSH & SH00 ;
SH01.d = SPRLD & D1
         # !SPRLD & SPRSH & SH02
         # !SPRLD & !SPRSH & SH01 ;
SH02.d = SPRLD & D2
         # !SPRLD & SPRSH & SH03
         # !SPRLD & !SPRSH & SH02 ;
SH03.d = SPRLD & D3
         # !SPRLD & SPRSH & SH04
         # !SPRLD & !SPRSH & SH03 ;
SH04.d = SPRLD & D4
         # !SPRLD & SPRSH & SH05
         # !SPRLD & !SPRSH & SH04 ;
SH05.d = SPRLD & D5
         # !SPRLD & SPRSH & SH06
         # !SPRLD & !SPRSH & SH05 ;
SH06.d = SPRLD & D6
         # !SPRLD & SPRSH & SH07
         # !SPRLD & !SPRSH & SH06 ;
SH07.d = SPRLD & D7
         # !SPRLD & !SPRSH & SH07 ;
SH10.d = SPRLD & D0
         # !SPRLD & SPRSH & SH11
         # !SPRLD & !SPRSH & SH10 ;
SH11.d = SPRLD & D1
         # !SPRLD & SPRSH & SH12
         # !SPRLD & !SPRSH & SH11 ;
SH12.d = SPRLD & D2
         # !SPRLD & SPRSH & SH13
         # !SPRLD & !SPRSH & SH12 ;
SH13.d = SPRLD & D3
         # !SPRLD & SPRSH & SH14
         # !SPRLD & !SPRSH & SH13 ;
SH14.d = SPRLD & D4
         # !SPRLD & SPRSH & SH15
         # !SPRLD & !SPRSH & SH14 ;
SH15.d = SPRLD & D5
         # !SPRLD & SPRSH & SH16
         # !SPRLD & !SPRSH & SH15 ;
SH16.d = SPRLD & D6
         # !SPRLD & SPRSH & SH17
         # !SPRLD & !SPRSH & SH16 ;
SH17.d = SPRLD & D7
         # !SPRLD & !SPRSH & SH17 ;
SLOTTICK = DP1 & DP0 ;
HBLANK = !ACTIVE ;
HSYNC = !HC7 & !HC6 & !HC5 & !HC4 & !HC3 ;
VSYNC = !VC9 & !VC8 & !VC7 & !VC6 & !VC5 & !VC4 & !VC3 & !VC2 & !VC1 & !VMODE0
        # VC1 & VMODE0
        # VC2 & VMODE0
        # VC3 & VMODE0 ;
VBLANK = VBLANKRAW ;
BLANK = HBLANK
        # VBLANK
        # !CT7 ;
FRAMEEND = SLOTTICK & HLAST & VTC ;
LINETICK = SLOTTICK & HLAST ;
FETCH = ACTIVE ;
SPARE = !DP1 ;
CELLTICK = SLOTTICK & !HC0 ;
HLOAD = HBLANK & HC4 & !HC5 ;
VLOAD = VBLANK ;
ROWADV = LINETICK & VACTIVE & !DBLHOLD ;
MCADV = CELLTICK ;
MAPLD = SPARE & CELLTICK ;
DBLHOLD.d = LINETICK & !DBLHOLD & !CT1
            # DBLHOLD & !LINETICK ;
MUXSEL0 = DP0 ;
MUXSEL1 = DP1 ;
PIXOE = !PALTURN ;
ATOE = !PALTURN & MODE1 # !PALTURN & MODE0 ;
PIDXOE = PALTURN ;
OMR = !BLANK ;
FOE0 = HS0 # HS1 ;
FOE1 = !HS0 & !HS1 ;
SPRA0 = SPRACT & SH00 ;
SPRA1 = SPRACT & SH10 ;
SPRACT = SPREN & !MODE1 & !MODE0 & SPRROW & !SW2 ;
SPRSH = SPRACT ;
SPRLD = HBLANK & SPRROW & HC3 & !HC4 ;
GMAP = SPARE & RMAP ;
GRD = SPARE & !RMAP & RRD ;
GCPY = SPARE & !RMAP & !RRD & RCPY ;
GSPN = SPARE & !RMAP & !RRD & !RCPY & RSPN ;
FBOESCAN = !SPARE
           # GMAP ;
FBOEPTR = GRD
          # GCPY
          # GSPN ;
HLAST = HC7 & HC6 & HC2 & HC1 & HC0 ;
ACTIVE = HC5 & !HC7 # HC7 & !HC6 & !HC5 & !HC4 & !HC3 & !HC2 ;
VACTIVE = !VBLANKRAW ;
VBLANKRAW = !VC9 & !VC8 & !VC7 & !VC6 & !VC5
            # VC9 & M0
            # VC9 & VC8 & !M0 ;
VTC = VC9 & VC7 & VC6 & VC4 & !M0
      # VC9 & VC8 & VC3 & VC2 & M0 ;
SPRVHIT = !SVC0 & !SVC1 & !SVC2 & !SVC3 & !SVC4 & !SVC5 & !SVC6 & !SVC7 & !SVC8 ;
SPRHIT = !SHC0 & !SHC1 & !SHC2 & !SHC3 & !SHC4 & !SHC5 & !SHC6 & !SHC7 & !SHC8 & !SHC9 ;
SPRROW = SPRVHIT
         # !SR2 ;
MODE0 = CT2 ;
MODE1 = CT3 ;
VMODE0 = CT0 ;

/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[DP0,DP1,HC0,HC1,HC2,HC3,HC4,HC5,HC6,HC7,VC0,VC1,VC2,VC3,VC4].ck = CLK25 ;
[VC5,VC6,VC7,VC8,VC9,M0,CT0,CT1,CT2,CT3,CT4,CT5,CT6,CT7,HS0].ck = CLK25 ;
[HS1,SX0,SX1,SX2,SX3,SX4,SX5,SX6,SX7,SX8,SX9,SY0,SY1,SY2,SY3].ck = CLK25 ;
[SY4,SY5,SY6,SY7,SY8,SPREN,SI0,SI1,SI2,SI3,SHC0,SHC1,SHC2].ck = CLK25 ;
[SHC3,SHC4,SHC5,SHC6,SHC7,SHC8,SHC9,SVC0,SVC1,SVC2,SVC3,SVC4].ck = CLK25 ;
[SVC5,SVC6,SVC7,SVC8,SW0,SW1,SW2,SR0,SR1,SR2,SH00,SH01,SH02].ck = CLK25 ;
[SH03,SH04,SH05,SH06,SH07,SH10,SH11,SH12,SH13,SH14,SH15,SH16].ck = CLK25 ;
[SH17,DBLHOLD].ck = CLK25 ;

