/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[T0,T1,T2,T3,BUSY,WT0,WT1,WT2,WC0,WC1,DUE0,DUE1,DUE2,DUE3].ck = SLOTCLK ;
[TDUE,TQ,DMAQ0,DMAQ1,DMAQ2,DMAQ3,RST0,RST1,RST2,RST3,HSY1].ck = SLOTCLK ;
[HSY2,HA0,HA1,HA2,HA3,HRW,HDUE,AIDX0,AIDX1,AIDX2,AIDX3,AIDX4].ck = SLOTCLK ;
[AIDX5,HW0,HW1,HW2,HL0,HL1,HRO,HSTAGE,HCOMMIT,SDQ0,SDQ1,SDQ2].ck = SLOTCLK ;
[PWBUSY,PFVALID,WROTE0,WROTE1,WROTE2,WROTE3,VDIRTY].ck = SLOTCLK ;
