        # !VLOAD & !SPRROW & SR4 ;
SPRA0.d = SQ0 & SPRACT ;
SPRA0.oe = SPRAOE ;
SPRA1.d = SQ1 & SPRACT ;
SPRA1.oe = SPRAOE ;
SLOTTICK = DP1 & DP0 ;
HBLANK = !ACTIVE ;
HSYNC = !HC7 & !HC6 & !HC5 & !HC4
        # !HC7 & !HC6 & !HC5 & !HC3 ;
VSYNC = !VC9 & !VC8 & !VC7 & !VC6 & !VC5 & !VC4 & !VC3 & !VC2 & !VC1 ;
VBLANK = VBLANKRAW ;
BLANK = HBLANK
        # VBLANK
        # !CT7 ;
FRAMEEND = SLOTTICK & HLAST & VTC ;
LINETICK = SLOTTICK & HLAST ;
SPARE = !DP1 ;
HLOAD = !HC7 & !HC6 & HC5 & !HC4 & !HC3 & !HC2 & !HC1
        # !HC7 & !HC6 & !HC5 & HC4 & HC3 & HC2 & HC1 ;
VLOAD = VBLANK ;
ROWADV = LINETICK & VACTIVE & !DBLHOLD ;
DBLHOLD.d = VBLANK & !CT1
            # LINETICK & !DBLHOLD & !CT1
            # DBLHOLD & !LINETICK ;
MWIN.d = SLOTTICK & !HC7 & !HC6 & !HC5 & HC4 & HC3 & HC2 & !HC1 & HC0
         # MWIN & !DP1
         # MWIN & !DP0
         # MWIN & !HC7
         # MWIN & !HC6
         # MWIN & !HC0 ;
MRQ.d = SLOTTICK & MWIN & MODE0 & HC0
        # SLOTTICK & MWIN & MODE1 & HC0 & !HS2
        # SLOTTICK & MWIN & MODE1 & !HC0 & HS2
        # SLOTTICK & SPREN & !MODE0 & !MODE1 & SPRROW & !HC7 & !HC6 & !HC5 & !HC4 & !HC3 & HC2 & HC1 & HC0
        # MRQ & !DP1
        # MRQ & !DP0 ;
MAPREQ = MRQ ;
MUXSEL0 = DP0 & !HS0
          # !DP0 & HS0 & !MODE0
          # DP0 & MODE0 ;
MUXSEL1 = DP1 & !HS1 & !HS0
          # !DP1 & HS1 & !HS0 & !MODE0
          # DP1 & !DP0 & !HS1
          # !DP1 & DP0 & !HS1 & HS0 & !MODE0
          # !DP1 & !DP0 & HS1 & !MODE0
          # DP1 & DP0 & HS1 & HS0
          # DP1 & MODE0 ;
PIXOE = !PALTURN ;
ATOE = !PALTURN & MODE0 ;
PIDXOE = PALTURN ;
SPRAOE = !PALTURN & !MODE0 ;
BD1.d = BLANK ;
OMR.d = !BD1 ;
OEA0 = HS1 & !MODE0
       # HS0 & !MODE0 ;
OEB0 = !HS1 & !HS0
       # MODE0 ;
OEA1 = HS1 & !MODE0 ;
OEB1 = !HS1
       # MODE0 ;
OEA2 = HS1 & HS0 & !MODE0 ;
OEB2 = !HS0
       # !HS1
       # MODE0 ;
SPRACT = SPREN & !MODE1 & !MODE0 & SPRROW & SPRHIT & ACTIVE ;
SPRSH = SPRACT ;
SPRLD = MRQ & !DP1 & DP0 & !MODE0 & !MODE1 ;
FBA2 = SR0 ;
FBA2.oe = MRQ & !DP1 & !MODE0 & !MODE1 ;
FBA3 = SR1 ;
FBA3.oe = MRQ & !DP1 & !MODE0 & !MODE1 ;
FBA4 = SR2 ;
FBA4.oe = MRQ & !DP1 & !MODE0 & !MODE1 ;
FBA5 = SR3 ;
FBA5.oe = MRQ & !DP1 & !MODE0 & !MODE1 ;
GMAP = SPARE & MAPREQ ;
GRD = SPARE & !MAPREQ & RDREQ ;
GCPY = SPARE & !MAPREQ & !RDREQ & RCPY ;
GSPN = SPARE & !MAPREQ & !RDREQ & !RCPY & SPANBUSY ;
FBOEPTR = GRD
          # GCPY
          # GSPN ;
HLAST = HC7 & HC6 & HC2 & HC1 & HC0 ;
ACTIVE.d = SLOTTICK & !HC7 & !HC6 & HC5 & !HC4 & !HC3 & !HC2 & HC1 & HC0
           # ACTIVE & !SLOTTICK
           # ACTIVE & !HC7
           # ACTIVE & !HC6
           # ACTIVE & !HC1
           # ACTIVE & !HC0 ;
VACTIVE = !VBLANKRAW ;
VBLANKRAW = !VC9 & !VC8 & !VC7 & !VC6 & !VC5
            # VC9 & M0
            # VC8 & VC7 & VC6 & !M0
            # VC8 & VC7 & VC5 & VC4 & !M0 ;
VTC = VC8 & VC7 & VC6 & !M0
      # VC9 & VC3 & VC2 & M0 ;
SPRVHIT = SVC0 & SVC1 & SVC2 & SVC3 & SVC4 & SVC5 & SVC6 & SVC7 & SVC8
          # SVQ ;
SPRHIT = SHC0 & SHC1 & SHC2 & SHC3 & SHC4 & SHC5 & SHC6 & SHC7 & SHC8 & SHC9
         # SHQ ;
SPRROW = SPRVHIT & !SR4 ;
VMODE0 = CT0 ;
MODE0 = CT2 ;
MODE1 = CT3 ;
WM0 = CT4 ;
WM1 = CT5 ;

/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[DP0,DP1,HC0,HC1,HC2,HC3,HC4,HC5,HC6,HC7,VC0,VC1,VC2,VC3,VC4].ck = CLK25 ;
[VC5,VC6,VC7,VC8,VC9,M0,CT0,CT1,CT2,CT3,CT4,CT5,CT7,HS0,HS1].ck = CLK25 ;
[HS2,SX0,SX1,SX2,SX3,SX4,SX5,SX6,SX7,SX8,SX9,SY0,SY1,SY2,SY3].ck = CLK25 ;
[SY4,SY5,SY6,SY7,SY8,SPREN,SHC0,SHC1,SHC2,SHC3,SHC4,SHC5].ck = CLK25 ;
[SHC6,SHC7,SHC8,SHC9,SVC0,SVC1,SVC2,SVC3,SVC4,SVC5,SVC6,SVC7].ck = CLK25 ;
[SVC8,SHQ,SVQ,SR0,SR1,SR2,SR3,SR4,SPRA0,SPRA1,DBLHOLD,MWIN].ck = CLK25 ;
[MRQ,BD1,OMR,ACTIVE].ck = CLK25 ;

