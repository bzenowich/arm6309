        # CRDSEL & CC1 ;

/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[WC0,WC1,WC2,WC3,WC4,WC5,WC6,WC7,WC8,WC9,WR0,WR1,WR2,WR3,WR4].ck = CLK25 ;
[WR5,WR6,WR7,WR8,CC0,CC1,CC2,CC3,CC4,CC5,CC6,CC7,CC8,CC9,CR0].ck = CLK25 ;
[CR1,CR2,CR3,CR4,CR5,CR6,CR7,CR8,CW0,CW1,CW2,CW3,CW4,CW5,CW6].ck = CLK25 ;
[CW7,CW8,CW9,CWN0,CWN1,CWN2,CWN3,CWN4,CWN5,CWN6,CWN7,CWN8].ck = CLK25 ;
[CWN9,CH0,CH1,CH2,CH3,CH4,CH5,CH6,CH7,CH8,GOQ,CBUSY,MS0,MS1].ck = CLK25 ;
[MS2,MS3,MS4,MS5,MS6,MS7,MS8,NSL0,NSL1,NSL2,NSL3,NSL4,NSL5].ck = CLK25 ;
[NSL6,NSL7,WADV0,WADV1,WADV2,SPANBUSY].ck = CLK25 ;

