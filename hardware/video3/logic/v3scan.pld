FBA16 = !GMAP & !MODE0 & !MODE1 & SA16
        # !GMAP & MODE0 & TB2
        # !GMAP & MODE1 & TB2
        # GMAP & MODE0 & MB0
        # GMAP & MODE1 & MB0
        # GMAP & !MODE0 & !MODE1 & MB0 ;
FBA16.oe = DP1 # MRQ ;
FBA17 = !GMAP & !MODE0 & !MODE1 & SA17
        # !GMAP & MODE0 & TB3
        # !GMAP & MODE1 & TB3
        # GMAP & MODE0 & MB1
        # GMAP & MODE1 & MB1
        # GMAP & !MODE0 & !MODE1 & MB1 ;
FBA17.oe = DP1 # MRQ ;
FBA18 = !GMAP & !MODE0 & !MODE1 & SA18
        # !GMAP & MODE0 & TB4
        # !GMAP & MODE1 & TB4
        # GMAP & MODE0 & MB2
        # GMAP & MODE1 & MB2
        # GMAP & !MODE0 & !MODE1 & MB2 ;
FBA18.oe = DP1 # MRQ ;

/* One clock for every register: the card is one slot-walked datapath
 * referred to its own oscillator (3.1), so there is only one. */
[MRQ2,HLQ,HS2,HS3,HS4,HS5,HS6,HS7,HS8,HS9,VS0,VS1,VS2,VS3].ck = CLK25 ;
[VS4,VS5,VS6,VS7,VS8,TB0,TB1,TB2,TB3,TB4,MB0,MB1,MB2,MAP0].ck = CLK25 ;
[MAP1,MAP2,MAP3,MAP4,MAP5,MAP6,MAP7,MAPA0,MAPA1,MAPA2,MAPA3].ck = CLK25 ;
[MAPA4,MAPA5,MAPA6,MAPA7,MAPQ0,MAPQ1,MAPQ2,MAPQ3,MAPQ4,MAPQ5].ck = CLK25 ;
[MAPQ6,MAPQ7,ATQ0,ATQ1,ATQ2,ATQ3,ATQ4,ATQ5,ATQ6,ATQ7,ATO0].ck = CLK25 ;
[ATO1,ATO2,ATO3,ATO4,ATO5,ATO6,ATO7,MC0,MC1,MC2,MC3,MC4,MC5].ck = CLK25 ;
[MC6,SA2,SA3,SA4,SA5,SA6,SA7,SA8,SA9,SA10,SA11,SA12,SA13].ck = CLK25 ;
[SA14,SA15,SA16,SA17,SA18].ck = CLK25 ;

